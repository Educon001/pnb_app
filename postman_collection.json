              "path": ["infractions", "severity", "LIGHT"]
            }
          }
        },
        {
          "name": "Por Tipo de Vehículo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/infractions/vehicle-type/CAR",
              "host": ["{{baseUrl}}"],
              "path": ["infractions", "vehicle-type", "CAR"]
            }
          }
        },
        {
          "name": "Estadísticas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/infractions/statistics",
              "host": ["{{baseUrl}}"],
              "path": ["infractions", "statistics"]
            }
          }
        },
        {
          "name": "Buscar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/infractions/search?term=velocidad",
              "host": ["{{baseUrl}}"],
              "path": ["infractions", "search"],
              "query": [
                {
                  "key": "term",
                  "value": "velocidad"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "🔧 Utilidades",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
