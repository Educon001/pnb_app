{
  "info": {
    "name": "PNB Multas Electrónicas API v3.0",
    "description": "Colección de Postman para la API de PNB Multas Electrónicas - Solo rutas implementadas",
    "version": "3.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "fineId",
      "value": "",
      "type": "string"
    },
    {
      "key": "infractionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "officerId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔐 Autenticación",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "AUTH_LOGIN"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"JRODRIGUEZ\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/v1/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.data.token);",
                  "    pm.collectionVariables.set('officerId', response.data.user._id);",
                  "    console.log('✅ Token guardado:', response.data.token);",
                  "    console.log('✅ Officer ID guardado:', response.data.user._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener Perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "AUTH_PROFILE"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "profile"]
            }
          }
        },
        {
          "name": "Actualizar Perfil",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "AUTH_UPDATE_PROFILE"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan Carlos\",\n  \"lastName\": \"Rodriguez\",\n  \"email\": \"jrodriguez@pnb.gob.ve\",\n  \"phone\": \"04121234567\",\n  \"address\": \"Comando General PNB, Caracas\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/v1/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "profile"]
            }
          }
        },
        {
          "name": "Cambiar Contraseña",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "AUTH_CHANGE_PASSWORD"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"123456\",\n  \"newPassword\": \"Nueva123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/v1/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "change-password"]
            }
          }
        },
        {
          "name": "Renovar Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "AUTH_RENEW_TOKEN"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/renew-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "renew-token"]
            }
          }
        },
        {
          "name": "Verificar Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "AUTH_VERIFY_TOKEN"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/verify-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "verify-token"]
            }
          }
        },
        {
          "name": "Cerrar Sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "AUTH_LOGOUT"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/v1/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "v1", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "🚨 Multas",
      "item": [
        {
          "name": "Crear Multa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"infractionId\": \"{{infractionId}}\",\n  \"description\": \"Conducir sin licencia\",\n  \"location\": {\n    \"address\": \"Av. Francisco de Miranda, Chacao, Caracas\",\n    \"coordinates\": {\n      \"latitude\": 10.4806,\n      \"longitude\": -66.9036\n    }\n  },\n  \"infractionDate\": \"2025-09-29T19:18:37.521Z\",\n  \"driverFirstName\": \"Carlos Alberto\",\n  \"driverLastName\": \"Martínez\",\n  \"driver\": \"12345678\",\n  \"driverPhone\": \"04121234567\",\n  \"driverEmail\": \"cmartinez@email.com\",\n  \"driverAddress\": \"Av. Principal, Caracas\",\n  \"driverLicenseGrade\": \"3\",\n  \"isOtherOwner\": false,\n  \"vehiclePlate\": \"ABC1234\",\n  \"vehicleType\": \"Carro\",\n  \"vehicleBrand\": \"Toyota\",\n  \"vehicleModel\": \"Corolla\",\n  \"vehicleColor\": \"Blanco\",\n  \"vehicleYear\": \"2018\",\n  \"evidence\": [\n    {\n      \"type\": \"PHOTO\",\n      \"url\": \"foto1.jpg\",\n      \"description\": \"Foto del vehículo\"\n    }\n  ],\n  \"notes\": \"Conductor sin licencia en zona escolar\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/fines/v1/create",
              "host": ["{{baseUrl}}"],
              "path": ["fines", "v1", "create"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('fineId', response.data._id);",
                  "    console.log('✅ Multa creada con ID:', response.data._id);",
                  "    console.log('✅ Número de multa:', response.data.fineNumber);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar Multas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "FINES_LIST"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fines/v1/list?page=1&limit=10&status=DRAFT&officer={{officerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["fines", "v1", "list"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "DRAFT",
                  "description": "DRAFT, SENT, PAID, CANCELLED"
                },
                {
                  "key": "officer",
                  "value": "{{officerId}}",
                  "disabled": false
                }
              ]
            }
          }
        },
        {
          "name": "Obtener Multa por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "FINES_GET"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fines/v1/{{fineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["fines", "v1", "{{fineId}}"]
            }
          }
        },
        {
          "name": "Actualizar Multa",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "FINES_UPDATE"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DRAFT\",\n  \"notes\": \"Multa actualizada con nueva información\",\n  \"description\": \"Descripción actualizada de la infracción\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/fines/v1/{{fineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["fines", "v1", "{{fineId}}"]
            }
          }
        },
        {
          "name": "Enviar Multa por Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "FINES_SEND"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fines/v1/{{fineId}}/send",
              "host": ["{{baseUrl}}"],
              "path": ["fines", "v1", "{{fineId}}", "send"]
            }
          }
        },
        {
          "name": "Cancelar Multa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "FINES_CANCEL"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Error en los datos del conductor - cédula incorrecta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/fines/v1/{{fineId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["fines", "v1", "{{fineId}}", "cancel"]
            }
          }
        },
        {
          "name": "Estadísticas de Multas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "FINES_STATS"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fines/v1/statistics?officer={{officerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["fines", "v1", "statistics"],
              "query": [
                {
                  "key": "officer",
                  "value": "{{officerId}}",
                  "disabled": false
                }
              ]
            }
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "FINES_DASHBOARD"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fines/v1/dashboard?officer={{officerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["fines", "v1", "dashboard"],
              "query": [
                {
                  "key": "officer",
                  "value": "{{officerId}}",
                  "disabled": false
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "📋 Infracciones",
      "item": [
        {
          "name": "Listar Infracciones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/infractions?page=1&limit=10&severity=LIGHT&active=true",
              "host": ["{{baseUrl}}"],
              "path": ["infractions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "severity",
                  "value": "LIGHT",
                  "disabled": false,
                  "description": "LIGHT, SERIOUS, VERY_SERIOUS"
                },
                {
                  "key": "active",
                  "value": "true",
                  "disabled": false
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.length > 0) {",
                  "        pm.collectionVariables.set('infractionId', response.data[0]._id);",
                  "        console.log('✅ Infracción seleccionada:', response.data[0].name);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener Infracción por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/infractions/{{infractionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["infractions", "{{infractionId}}"]
            }
          }
        },
        {
          "name": "Crear Infracción",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
