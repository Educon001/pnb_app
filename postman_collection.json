              "raw": "{\n  \"code\": \"ART007\",\n  \"name\": \"No usar cinturón de seguridad\",\n  \"description\": \"Conducir sin usar el cinturón de seguridad\",\n  \"article\": \"Art. 89\",\n  \"severity\": \"LIGHT\",\n  \"vehicleType\": \"CAR\",\n  \"taxUnits\": 3,\n  \"bolivarValue\": 180,\n  \"licensePoints\": 1,\n  \"requiresPhoto\": false,\n  \"requiresEvidence\": false\n}"
            },
            "url": {
